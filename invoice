<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>سیستم صدور فاکتور طلایی - رایان طرح</title>
    
    <!-- Tailwind CSS with dynamic config capability -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        window.tailwind = {
            config: {
                theme: {
                    extend: {
                        fontFamily: {
                            sans: ['Vazirmatn', 'sans-serif'],
                        }
                    }
                }
            }
        }
    </script>
    
    <!-- Vazirmatn Font -->
    <link href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.0.0/Vazirmatn-font-face.css" rel="stylesheet" type="text/css" />
    
    <!-- html2pdf.js for PDF generation -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

    <!-- KamaDatepicker (Lightweight Persian Datepicker) -->
    <link type="text/css" rel="stylesheet" href="https://cdn.jsdelivr.net/npm/kamadatepicker@1.5.3/dist/kamadatepicker.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/kamadatepicker@1.5.3/dist/kamadatepicker.min.js"></script>
    
    <style>
        :root {
            --brand-primary: #0f172a; /* Slate 900 */
            --brand-accent: #0ea5e9;  /* Sky 500 */
            --brand-light: #f8fafc;   /* Slate 50 */
            --brand-border: #cbd5e1;  /* Slate 300 */
        }

        body {
            font-family: 'Vazirmatn', sans-serif;
            background-color: #f1f5f9;
        }
        
        /* A4 Paper styling for the preview (Strictly fit to single page) */
        .a4-paper {
            width: 210mm;
            min-height: 297mm;
            background: white;
            box-shadow: 0 10px 25px rgba(0,0,0,0.08);
            margin: 0 auto;
            padding: 10mm 12mm;
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
            font-family: 'Vazirmatn', sans-serif !important;
        }

        /* Scaled Preview for Mobile and Desktop views */
        .preview-container {
            overflow: auto;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            padding-top: 1.5rem;
            padding-bottom: 1.5rem;
        }

        @media (max-width: 1024px) {
            .a4-paper {
                transform: scale(0.75);
                transform-origin: top center;
                margin-bottom: -75mm; 
            }
        }
        @media (max-width: 768px) {
            .a4-paper {
                transform: scale(0.52);
                transform-origin: top center;
                margin-bottom: -140mm;
            }
        }

        /* Modernized Dynamic Theme Classes */
        .dynamic-header-bg { background-color: var(--brand-primary); }
        .dynamic-text-color { color: var(--brand-primary); }
        .dynamic-accent-color { color: var(--brand-accent); }
        .dynamic-accent-bg { background-color: var(--brand-accent); }
        .dynamic-border { border-color: var(--brand-border); }
        .dynamic-light-bg { background-color: var(--brand-light); }

        /* Invoice Table Structure */
        .invoice-table {
            border-collapse: separate;
            border-spacing: 0;
            width: 100%;
        }
        .invoice-table th, .invoice-table td {
            border: 1px solid var(--brand-border); 
            padding: 7px 6px;
            text-align: center;
        }
        .invoice-table th {
            background-color: var(--brand-light);
            font-weight: bold;
            color: #0f172a;
        }
        .invoice-table tr:first-child th:first-child { border-top-right-radius: 6px; }
        .invoice-table tr:first-child th:last-child { border-top-left-radius: 6px; }

        /* Scrollbar customizer */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #f1f5f9; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
        
        /* KamaDatepicker custom z-index */
        #bd-root { z-index: 100 !important; }

        /* Active Tab indicator styles */
        .tab-btn.active {
            border-bottom-width: 2px;
            border-color: var(--brand-accent);
            color: var(--brand-primary);
            font-weight: bold;
        }

        /* Hide number input arrows for cleaner forms */
        input[type=number]::-webkit-inner-spin-button, 
        input[type=number]::-webkit-outer-spin-button { 
            -webkit-appearance: none; margin: 0; 
        }
        input[type=number] { -moz-appearance: textfield; }
        
        .custom-scrollbar::-webkit-scrollbar { height: 4px; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #e2e8f0; }
    </style>
</head>
<body class="h-screen flex flex-col overflow-hidden text-gray-800">

    <header class="bg-slate-900 text-white p-3 shadow-md z-20 flex justify-between items-center px-6">
        <div class="flex items-center gap-3">
            <div class="bg-sky-500 text-white p-1.5 rounded-lg">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </div>
            <h1 class="text-lg font-bold">رایان طرح <span class="text-sky-300 text-xs font-normal">| دستیار صدور فاکتور مالی هوشمند</span></h1>
        </div>
        
        <div class="flex items-center gap-2">
            <button onclick="generatePDF()" class="bg-emerald-500 hover:bg-emerald-600 transition text-white px-4 py-2 rounded-lg flex items-center gap-2 text-sm font-bold shadow-md">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
                خروجی PDF فاکتور
            </button>
        </div>
    </header>

    <!-- Main Container -->
    <div class="flex flex-1 overflow-hidden flex-col lg:flex-row">
        
        <!-- Tabbed Menu to keep the screen extremely clean and functional -->
        <div class="w-full lg:w-[440px] bg-white shadow-xl flex flex-col border-l border-slate-200 z-10 overflow-hidden">
            <!-- Tabs Header -->
            <div class="flex border-b border-slate-200 bg-slate-50 text-xs select-none overflow-x-auto custom-scrollbar">
                <button onclick="switchTab('tab-buyer')" id="btn-tab-buyer" class="tab-btn min-w-[85px] flex-1 py-3 text-center text-slate-600 hover:bg-white transition border-b-2 border-transparent active">
                    مشخصات سند
                </button>
                <button onclick="switchTab('tab-items')" id="btn-tab-items" class="tab-btn min-w-[85px] flex-1 py-3 text-center text-slate-600 hover:bg-white transition border-b-2 border-transparent">
                    اقلام فاکتور
                </button>
                <button onclick="switchTab('tab-products')" id="btn-tab-products" class="tab-btn min-w-[85px] flex-1 py-3 text-center text-slate-600 hover:bg-white transition border-b-2 border-transparent">
                    محصولات من
                </button>
                <button onclick="switchTab('tab-payment')" id="btn-tab-payment" class="tab-btn min-w-[85px] flex-1 py-3 text-center text-slate-600 hover:bg-white transition border-b-2 border-transparent">
                    تسویه حساب
                </button>
                <button onclick="switchTab('tab-archive')" id="btn-tab-archive" class="tab-btn min-w-[70px] flex-1 py-3 text-center text-slate-600 hover:bg-white transition border-b-2 border-transparent">
                    آرشیو
                </button>
            </div>

            <!-- Tabs Content Container -->
            <div class="flex-1 overflow-y-auto p-4 space-y-4">
                
                <div id="tab-buyer" class="tab-content space-y-4">
                    <!-- Basic Info -->
                    <div class="bg-slate-50 p-3 rounded-lg border border-slate-200">
                        <h3 class="text-sm font-bold text-slate-800 mb-2 flex items-center gap-1.5">
                            <span class="w-1.5 h-3 bg-sky-500 rounded-full"></span> تنظیمات اولیه
                        </h3>
                        <div class="mb-3">
                            <label class="flex items-center gap-2 cursor-pointer bg-white p-2 border rounded-lg hover:bg-slate-100 transition">
                                <input type="checkbox" id="input-is-proforma" class="w-4 h-4 text-sky-600 rounded focus:ring-sky-500" onchange="updatePreview()">
                                <span class="text-xs font-bold text-gray-700">این سند «پیش‌فاکتور» است</span>
                            </label>
                        </div>
                        <div class="grid grid-cols-2 gap-2">
                            <div>
                                <label class="block text-[10px] text-gray-600 mb-1 font-bold">شماره فاکتور</label>
                                <input type="text" id="input-invoice-number" class="w-full border rounded p-1.5 text-xs outline-none focus:ring-1 focus:ring-sky-500" value="1405/101" oninput="updatePreview()">
                            </div>
                            <div>
                                <label class="block text-[10px] text-gray-600 mb-1 font-bold">تاریخ شمسی</label>
                                <input type="text" id="input-invoice-date" class="w-full border rounded p-1.5 text-xs outline-none focus:ring-1 focus:ring-sky-500 cursor-pointer bg-white" readonly onchange="updatePreview()">
                            </div>
                        </div>
                    </div>

                    <!-- Buyer Info -->
                    <div class="bg-slate-50 p-3 rounded-lg border border-slate-200">
                        <div class="flex justify-between items-center mb-2">
                            <h3 class="text-sm font-bold text-slate-800 flex items-center gap-1.5">
                                <span class="w-1.5 h-3 bg-sky-500 rounded-full"></span> مشخصات خریدار (مشتری)
                            </h3>
                            <button onclick="saveCurrentBuyer()" class="text-[9px] bg-sky-100 hover:bg-sky-200 text-sky-700 px-2 py-0.5 rounded transition">ذخیره مشتری</button>
                        </div>
                        
                        <!-- Toggle Type -->
                        <div class="flex gap-4 mb-3 border-b border-slate-200 pb-2">
                            <label class="flex items-center gap-1.5 cursor-pointer text-xs font-bold text-slate-700">
                                <input type="radio" name="buyer_type" value="real" checked onchange="toggleBuyerType()" class="text-sky-500 w-3.5 h-3.5 focus:ring-sky-500">
                                شخص حقیقی
                            </label>
                            <label class="flex items-center gap-1.5 cursor-pointer text-xs font-bold text-slate-700">
                                <input type="radio" name="buyer_type" value="legal" onchange="toggleBuyerType()" class="text-sky-500 w-3.5 h-3.5 focus:ring-sky-500">
                                شخص حقوقی (شرکت)
                            </label>
                        </div>

                        <div class="space-y-2">
                            <!-- Real Person Fields -->
                            <div id="buyer-real-fields" class="space-y-2">
                                <div>
                                    <label class="block text-[10px] text-gray-600 mb-0.5">نام و نام خانوادگی <span class="text-red-500">*</span></label>
                                    <input type="text" id="input-buyer-name" placeholder="مثال: علی احمدی" class="w-full border rounded p-1.5 text-xs outline-none focus:ring-1 focus:ring-sky-500" oninput="updatePreview()">
                                </div>
                                <div>
                                    <label class="block text-[10px] text-gray-600 mb-0.5">کد ملی</label>
                                    <input type="text" id="input-buyer-nid" placeholder="مثال: 0012345678" class="w-full border rounded p-1.5 text-xs outline-none focus:ring-1 focus:ring-sky-500" oninput="updatePreview()">
                                </div>
                            </div>

                            <!-- Legal Entity Fields (Hidden by default) -->
                            <div id="buyer-legal-fields" class="space-y-2 hidden">
                                <div>
                                    <label class="block text-[10px] text-gray-600 mb-0.5">نام شرکت / سازمان <span class="text-red-500">*</span></label>
                                    <input type="text" id="input-buyer-company" placeholder="مثال: شرکت تجارت برنا" class="w-full border rounded p-1.5 text-xs outline-none focus:ring-1 focus:ring-sky-500" oninput="updatePreview()">
                                </div>
                                <div class="grid grid-cols-2 gap-2">
                                    <div>
                                        <label class="block text-[10px] text-gray-600 mb-0.5">شناسه ملی (اختیاری)</label>
                                        <input type="text" id="input-buyer-national-id" placeholder="۱۰۱۰۱۲۳۴۵۶" class="w-full border rounded p-1.5 text-xs outline-none focus:ring-1 focus:ring-sky-500" oninput="updatePreview()">
                                    </div>
                                    <div>
                                        <label class="block text-[10px] text-gray-600 mb-0.5">شماره ثبت (اختیاری)</label>
                                        <input type="text" id="input-buyer-reg-num" placeholder="۱۲۳۴۵" class="w-full border rounded p-1.5 text-xs outline-none focus:ring-1 focus:ring-sky-500" oninput="updatePreview()">
                                    </div>
                                </div>
                            </div>

                            <div>
                                <label class="block text-[10px] text-gray-600 mb-0.5">تلفن تماس</label>
                                <input type="text" id="input-buyer-phone" placeholder="۰۲۱۸۸۸۸۸۸۸" class="w-full border rounded p-1.5 text-xs outline-none focus:ring-1 focus:ring-sky-500" oninput="updatePreview()">
                            </div>
                            <div>
                                <label class="block text-[10px] text-gray-600 mb-0.5">آدرس کامل</label>
                                <textarea id="input-buyer-address" rows="2" placeholder="تهران، خیابان آزادی..." class="w-full border rounded p-1.5 text-xs outline-none focus:ring-1 focus:ring-sky-500 resize-none" oninput="updatePreview()"></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="tab-items" class="tab-content hidden space-y-4">
                    <!-- Quick Services Selector -->
                    <div class="bg-slate-50 p-3 rounded-lg border border-slate-200 shadow-sm">
                        <label class="block text-[11px] font-bold text-slate-700 mb-1">افزودن سریع کالا / خدمات:</label>
                        <select id="common-services" onchange="addCommonService(this.value)" class="w-full border rounded p-1.5 text-xs bg-white outline-none focus:ring-1 focus:ring-sky-500 cursor-pointer">
                            <option value="">-- انتخاب از لیست محصولات --</option>
                            <!-- Dynamically loaded -->
                        </select>
                    </div>

                    <!-- Items Container -->
                    <div class="space-y-2">
                        <div class="flex justify-between items-center">
                            <h4 class="text-xs font-bold text-slate-700">لیست اقلام (حداکثر ۵ قلم)</h4>
                            <span id="items-count-badge" class="text-[9px] font-bold bg-sky-100 text-sky-800 px-2 py-0.5 rounded-full">0/5</span>
                        </div>
                        <div id="items-container" class="space-y-2"></div>
                        <button id="add-item-btn" onclick="addNewItem()" class="w-full border border-dashed border-slate-300 hover:border-sky-500 hover:bg-slate-50 text-slate-600 hover:text-sky-600 transition py-1.5 rounded-lg text-xs font-bold flex items-center justify-center gap-1">
                            + افزودن ردیف دستی
                        </button>
                    </div>

                    <!-- Financial extras -->
                    <div class="bg-slate-50 p-3 rounded-lg border border-slate-200 space-y-3 shadow-sm">
                        <h4 class="text-xs font-bold text-slate-700">تخفیف کل فاکتور و مالیات</h4>
                        <div class="grid grid-cols-2 gap-2">
                            <div>
                                <label class="block text-[10px] text-gray-600 mb-1 font-bold">تخفیف کل (درصد %)</label>
                                <div class="relative">
                                    <input type="number" id="input-discount" placeholder="0" class="w-full border rounded p-1.5 text-xs text-center outline-none focus:ring-1 focus:ring-sky-500 text-red-600 font-bold bg-white" value="0" min="0" max="100" oninput="updatePreview()">
                                    <span class="absolute left-2 top-1.5 text-[10px] text-red-400">%</span>
                                </div>
                            </div>
                            <div>
                                <label class="block text-[10px] text-gray-600 mb-1 font-bold">ارزش افزوده (%)</label>
                                <div class="flex items-center gap-1.5 bg-white border rounded p-1.5">
                                    <input type="checkbox" id="tax-toggle" onchange="updatePreview()" class="w-3.5 h-3.5 text-sky-600 cursor-pointer">
                                    <input type="number" id="tax-percent" value="10" min="0" max="100" class="w-full border-0 p-0 text-xs text-center outline-none font-bold text-slate-700 bg-transparent" oninput="updatePreview()">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- NEW TAB: Products Management -->
                <div id="tab-products" class="tab-content hidden space-y-4">
                    <div class="bg-slate-50 p-3 rounded-lg border border-slate-200 shadow-sm">
                        <h3 class="text-xs font-bold text-slate-800 mb-2 flex items-center gap-1.5">
                            <span class="w-1.5 h-3 bg-emerald-500 rounded-full"></span> تعریف محصول / خدمت جدید
                        </h3>
                        <p class="text-[9px] text-slate-500 mb-3 leading-relaxed">با ذخیره محصولات در این بخش، می‌توانید در تب «اقلام فاکتور» با یک کلیک آن‌ها را به فاکتور اضافه کنید.</p>
                        
                        <div class="space-y-2 mb-3">
                            <div>
                                <label class="block text-[10px] text-gray-600 mb-0.5">عنوان محصول یا خدمت</label>
                                <input type="text" id="new-prod-name" placeholder="مثال: طراحی رابط کاربری" class="w-full border rounded p-1.5 text-xs outline-none focus:ring-1 focus:ring-emerald-500">
                            </div>
                            <div>
                                <label class="block text-[10px] text-gray-600 mb-0.5">قیمت پایه (تومان)</label>
                                <div class="relative">
                                    <input type="text" id="new-prod-price" placeholder="مثال: 5,000,000" class="w-full border rounded p-1.5 text-xs pr-2 pl-12 outline-none focus:ring-1 focus:ring-emerald-500 font-mono text-left" dir="ltr" oninput="formatAndProcessInput(this)">
                                    <span class="absolute left-2 top-1.5 text-[9px] text-gray-400">تومان</span>
                                </div>
                            </div>
                        </div>
                        <button onclick="saveCustomProduct()" class="w-full bg-emerald-500 hover:bg-emerald-600 text-white font-bold py-1.5 rounded text-xs transition shadow-sm">
                            + ذخیره در لیست محصولات
                        </button>
                    </div>

                    <div class="space-y-2">
                        <h3 class="text-xs font-bold text-slate-800">لیست محصولات ذخیره شده</h3>
                        <div id="custom-products-list" class="space-y-2 max-h-[250px] overflow-y-auto custom-scrollbar pr-1">
                            <!-- Injected by JS -->
                        </div>
                    </div>
                </div>

                <div id="tab-payment" class="tab-content hidden space-y-4">
                    <!-- Brand Colors (Theme selector) -->
                    <div class="bg-slate-50 p-3 rounded-lg border border-slate-200">
                        <h3 class="text-xs font-bold text-slate-800 mb-2">شخصی‌سازی رنگ سازمانی فاکتور</h3>
                        <div class="grid grid-cols-5 gap-1.5">
                            <button onclick="setTheme('#0f172a', '#0ea5e9', '#f8fafc', '#cbd5e1')" class="h-8 rounded bg-slate-800 border border-slate-300 text-white text-[10px] font-bold flex items-center justify-center" title="آبی کلاسیک">سرمه‌ای</button>
                            <button onclick="setTheme('#064e3b', '#10b981', '#f0fdf4', '#a7f3d0')" class="h-8 rounded bg-emerald-800 border border-slate-300 text-white text-[10px] font-bold flex items-center justify-center" title="سبز زمردی">زمردی</button>
                            <button onclick="setTheme('#5b21b6', '#8b5cf6', '#faf5ff', '#e9d5ff')" class="h-8 rounded bg-purple-800 border border-slate-300 text-white text-[10px] font-bold flex items-center justify-center" title="بنفش سلطنتی">بنفش</button>
                            <button onclick="setTheme('#991b1b', '#ef4444', '#fef2f2', '#fca5a5')" class="h-8 rounded bg-red-800 border border-slate-300 text-white text-[10px] font-bold flex items-center justify-center" title="سرخ ایرانی">قرمز</button>
                            <button onclick="setTheme('#1e293b', '#64748b', '#f8fafc', '#e2e8f0')" class="h-8 rounded bg-slate-700 border border-slate-300 text-white text-[10px] font-bold flex items-center justify-center" title="ذغالی مینیمال">ذغالی</button>
                        </div>
                    </div>

                    <!-- Payment & Bank Accounts details -->
                    <div class="bg-slate-50 p-3 rounded-lg border border-slate-200 space-y-2">
                        <div class="flex justify-between items-center">
                            <h3 class="text-xs font-bold text-slate-800">جزئیات واریز و پرداخت بانکی</h3>
                            <label class="flex items-center gap-1 cursor-pointer">
                                <input type="checkbox" id="show-bank-toggle" checked onchange="updatePreview()" class="w-3.5 h-3.5 text-sky-600">
                                <span class="text-[9px] text-gray-500">نمایش در فاکتور</span>
                            </label>
                        </div>
                        <div class="grid grid-cols-2 gap-2">
                            <div>
                                <label class="block text-[9px] text-gray-500">نام بانک</label>
                                <input type="text" id="bank-name" value="بانک ملی ایران" class="w-full border rounded p-1 text-xs outline-none" oninput="updatePreview()">
                            </div>
                            <div>
                                <label class="block text-[9px] text-gray-500">صاحب حساب</label>
                                <input type="text" id="bank-owner" value="رایان طرح (مدیریت مالی)" class="w-full border rounded p-1 text-xs outline-none" oninput="updatePreview()">
                            </div>
                        </div>
                        <div class="grid grid-cols-2 gap-2">
                            <div>
                                <label class="block text-[9px] text-gray-500">شماره کارت</label>
                                <input type="text" id="bank-card" value="۶۰۳۷-۹۹۱۹-۹۹۹۹-۹۹۹۹" class="w-full border rounded p-1 text-xs outline-none font-mono text-center" oninput="updatePreview()">
                            </div>
                            <div>
                                <label class="block text-[9px] text-gray-500">شماره شبا</label>
                                <input type="text" id="bank-shaba" value="IR96-0170-0000-0010-0000-0001" class="w-full border rounded p-1 text-xs outline-none font-mono text-center text-xs" oninput="updatePreview()">
                            </div>
                        </div>
                    </div>

                    <!-- Terms & Signature, QR Details -->
                    <div class="bg-slate-50 p-3 rounded-lg border border-slate-200 space-y-2">
