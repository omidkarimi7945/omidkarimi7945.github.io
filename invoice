    <script>
        // --- State ---
        let items = [];
        const MAX_ITEMS = 5;
        let myProducts = [];

        // Custom template terms
        const TERMS_TEMPLATES = {
            standard: "تسویه حساب کامل فاکتور حداکثر تا ۲۴ ساعت پس از تحویل مستندات پروژه الزامی می‌باشد.",
            prepay: "شروع کار و انجام فرآیند منوط به پرداخت ۵۰٪ مبلغ فاکتور به عنوان پیش‌پرداخت می‌باشد و ۵۰٪ مابقی پیش از تحویل فاکتور تسویه می‌گردد.",
            seven_days: "با توجه به توافقات صورت‌گرفته، خریدار محترم موظف است حداکثر ظرف مدت ۷ روز کاری نسبت به تسویه کل فاکتور اقدام نماید."
        };

        // Services pre-filled DB
        const SERVICES_DB = {
            "web_corp": { desc: "طراحی و توسعه وب‌سایت شرکتی", price: 12000000 },
            "web_store": { desc: "طراحی فروشگاه اینترنتی اختصاصی", price: 25000000 },
            "seo": { desc: "خدمات سئو، تحلیل کلمات کلیدی (ماهانه)", price: 6500000 },
            "support": { desc: "پشتیبانی سالانه امنیت و هاست", price: 5000000 },
            "logo": { desc: "طراحی لوگو و هویت بصری برند", price: 4.5 * 1000000 }
        };

        // --- Number format utilities ---
        function formatNumber(num) {
            return parseFloat(num).toLocaleString('en-US');
        }

        function parseFormattedNumber(str) {
            if(!str) return 0;
            return parseFloat(str.toString().replace(/,/g, '')) || 0;
        }

        // --- Number to Persian Words translator ---
        const P_ONES = ['', 'یک', 'دو', 'سه', 'چهار', 'پنج', 'شش', 'هفت', 'هشت', 'نه'];
        const P_TENS = ['', 'ده', 'بیست', 'سی', 'چهل', 'پنجاه', 'شصت', 'هفتاد', 'هشتاد', 'نود'];
        const P_HUNDREDS = ['', 'صد', 'دویست', 'سیصد', 'چهارصد', 'پانصد', 'ششصد', 'هفتصد', 'هشتصد', 'نهصد'];
        const P_ELEVENS = ['ده', 'یازده', 'دوازده', 'سیزده', 'چهارده', 'پانزده', 'شانزده', 'هفده', 'هجده', 'نوزده'];
        const P_LEVELS = ['', 'هزار', 'میلیون', 'میلیارد', 'تریلیون'];

        function numToPersianWords(num) {
            if (num === 0) return 'صفر';
            let strNum = num.toString();
            let level = 0;
            let result = [];
            
            while (strNum.length > 0) {
                let part = strNum.slice(-3);
                strNum = strNum.slice(0, -3);
                let p_part = partToPersian(parseInt(part));
                if (p_part) {
                    result.push(p_part + (P_LEVELS[level] ? ' ' + P_LEVELS[level] : ''));
                }
                level++;
            }
            return result.reverse().join(' و ');
        }

        function partToPersian(num) {
            if (num === 0) return '';
            let res = [];
            let h = Math.floor(num / 100);
            let t = Math.floor((num % 100) / 10);
            let o = num % 10;

            if (h > 0) res.push(P_HUNDREDS[h]);
            if (t === 1) {
                res.push(P_ELEVENS[o]);
            } else {
                if (t > 1) res.push(P_TENS[t]);
                if (o > 0) res.push(P_ONES[o]);
            }
            return res.join(' و ');
        }

        window.onload = function() {
            // Safe kamaDatepicker Initialization
            try {
                if (typeof kamaDatepicker === 'function') {
                    kamaDatepicker('input-invoice-date', {
                        placeholder: 'انتخاب تاریخ',
                        twodigit: true,
                        closeAfterSelect: true,
                        buttonsColor: "blue",
                        forceFarsiDigits: true,
                        markToday: true,
                        sync: true,
                        gotoToday: true
                    });
                }
            } catch (err) {
                console.warn("KamaDatepicker failed initialization, falling back gracefully.");
            }

            // Set current date as default
            const today = new Date().toLocaleDateString('fa-IR', { year: 'numeric', month: '2-digit', day: '2-digit' });
            const dateInput = document.getElementById('input-invoice-date');
            if (dateInput && dateInput.value === '') {
                dateInput.value = today;
            }

            // Initialize App state
            addNewItem();
            loadArchiveHistoryList();
            loadCustomProducts();
            updatePreview();
        };

        // Custom Products Management
        function loadCustomProducts() {
            myProducts = JSON.parse(localStorage.getItem('rayan_custom_products') || '[]');
            renderCustomProductsList();
            renderCommonServicesDropdown();
        }

        function saveCustomProduct() {
            const nameInput = document.getElementById('new-prod-name');
            const priceInput = document.getElementById('new-prod-price');
            const name = nameInput.value.trim();
            const price = parseFormattedNumber(priceInput.value);

            if(!name || price <= 0) {
                showNotification('لطفاً عنوان محصول و قیمت معتبر را وارد کنید.', 'error');
                return;
            }

            const newProd = { id: Date.now().toString(), desc: name, price: price };
            myProducts.push(newProd);
            localStorage.setItem('rayan_custom_products', JSON.stringify(myProducts));
            
            nameInput.value = '';
            priceInput.value = '';
            
            loadCustomProducts();
            showNotification('محصول جدید با موفقیت به لیست اضافه شد.');
        }

        function deleteCustomProduct(id) {
            myProducts = myProducts.filter(p => p.id !== id.toString());
            localStorage.setItem('rayan_custom_products', JSON.stringify(myProducts));
            loadCustomProducts();
            showNotification('محصول از لیست شما حذف شد.', 'error');
        }

        function renderCustomProductsList() {
            const container = document.getElementById('custom-products-list');
            if (myProducts.length === 0) {
                container.innerHTML = `<div class="text-[10px] text-gray-400 text-center py-4 bg-slate-50 border rounded border-dashed">شما هنوز محصولی تعریف نکرده‌اید.</div>`;
                return;
            }

            container.innerHTML = myProducts.map(p => `
                <div class="bg-white border border-emerald-100 rounded p-2 flex justify-between items-center shadow-sm">
                    <div>
                        <div class="text-xs font-bold text-slate-700">${p.desc}</div>
                        <div class="text-[10px] text-emerald-600 font-mono font-bold mt-0.5">${formatNumber(p.price)} تومان</div>
                    </div>
                    <button onclick="deleteCustomProduct('${p.id}')" class="text-red-400 hover:text-red-600 hover:bg-red-50 p-1.5 rounded transition">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
                        </svg>
                    </button>
                </div>
            `).join('');
        }

        function renderCommonServicesDropdown() {
            const select = document.getElementById('common-services');
            let optionsHtml = `<option value="">-- انتخاب از لیست محصولات --</option>`;
            
            if(myProducts.length > 0) {
                optionsHtml += `<optgroup label="✨ محصولات اختصاصی من">`;
                myProducts.forEach(p => {
                    optionsHtml += `<option value="custom_${p.id}">${p.desc} - (${formatNumber(p.price)} ت)</option>`;
                });
                optionsHtml += `</optgroup>`;
            }

            optionsHtml += `<optgroup label="خدمات پیش‌فرض رایان طرح">`;
            for(const key in SERVICES_DB) {
                optionsHtml += `<option value="db_${key}">${SERVICES_DB[key].desc}</option>`;
            }
            optionsHtml += `</optgroup>`;

            select.innerHTML = optionsHtml;
        }

        // UI Tabs Switcher
        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));
            
            document.getElementById(tabId).classList.remove('hidden');
            document.getElementById('btn-' + tabId).classList.add('active');
        }

        // Status Feedback / Toasts
        function showNotification(msg, type = 'success') {
            const toast = document.getElementById('toast-notif');
            toast.textContent = msg;
            toast.className = `m-3 p-2.5 rounded-lg text-xs font-bold text-center block shadow transition ${type === 'success' ? 'bg-emerald-100 text-emerald-800 border border-emerald-300' : 'bg-red-100 text-red-800 border border-red-300'}`;
            setTimeout(() => { toast.classList.add('hidden'); }, 3000);
        }

        // Apply templates
        function applyTermsTemplate(templateKey) {
            const val = TERMS_TEMPLATES[templateKey] || '';
            document.getElementById('input-terms').value = val;
            updatePreview();
        }

        // Customize Theme Live
        function setTheme(primary, accent, light, border) {
            const root = document.documentElement;
            root.style.setProperty('--brand-primary', primary);
            root.style.setProperty('--brand-accent', accent);
            root.style.setProperty('--brand-light', light);
            root.style.setProperty('--brand-border', border);
            
            updatePreview();
            showNotification('رنگ قالب فاکتور با موفقیت تغییر کرد.');
        }

        // Save signature upload
        function uploadSignatureImage(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const img = document.getElementById('preview-signature-img');
                    img.src = e.target.result;
                    img.classList.remove('hidden');
                    document.getElementById('preview-signature-placeholder').classList.add('hidden');
                    showNotification('مهر و امضا دیجیتال با موفقیت آپلود شد.');
                    updatePreview();
                };
                reader.readAsDataURL(file);
            }
        }

        // Quick service loading
        function addCommonService(val) {
            if(!val) return;
            if (items.length >= MAX_ITEMS) {
                showNotification('برای قالب فاکتور تک‌صفحه‌ای حداکثر ۵ ردیف مجاز است.', 'error');
                document.getElementById('common-services').value = '';
                return;
            }
            
            let desc = "", price = 0;
            
            if(val.startsWith('custom_')) {
                const id = val.split('custom_')[1];
                const prod = myProducts.find(p => p.id === id);
                if(prod) { desc = prod.desc; price = prod.price; }
            } else if (val.startsWith('db_')) {
                const key = val.split('db_')[1];
                const srv = SERVICES_DB[key];
                if(srv) { desc = srv.desc; price = srv.price; }
            }

            const id = Date.now();
            items.push({ id, desc: desc, qty: 1, price: price, discountPercent: 0 });
            
            document.getElementById('common-services').value = '';
            renderInputItems();
            updatePreview();
            showNotification('آیتم با موفقیت به فاکتور اضافه شد.');
        }

        function addNewItem() {
            if (items.length >= MAX_ITEMS) {
                showNotification('برای فاکتور تک‌صفحه‌ای حداکثر ۵ ردیف مجاز است.', 'error');
                return;
            }
            const id = Date.now() + Math.random();
            items.push({ id, desc: '', qty: 1, price: 0, discountPercent: 0 });
            renderInputItems();
            updatePreview();
        }

        function deleteItem(id) {
            items = items.filter(item => item.id !== id);
            renderInputItems();
            updatePreview();
        }

        function editItemValue(id, field, val) {
            const idx = items.findIndex(item => item.id === id);
            if (idx > -1) {
                if (field === 'qty' || field === 'price') {
                    let rawVal = val.toString().replace(/,/g, '');
                    items[idx][field] = parseFloat(rawVal) || 0;
                } else if (field === 'discountPercent') {
                    let p = parseFloat(val) || 0;
                    if(p < 0) p = 0;
                    if(p > 100) p = 100;
                    items[idx][field] = p;
                } else {
                    items[idx][field] = val;
                }
                updatePreview();
            }
        }

        function formatAndProcessInput(input) {
            let clean = input.value.replace(/,/g, '');
            if(clean && !isNaN(clean)) {
                input.value = formatNumber(clean);
            }
        }

        // Toggle Real/Legal Buyer Type
        function toggleBuyerType() {
            const type = document.querySelector('input[name="buyer_type"]:checked').value;
            if (type === 'real') {
                document.getElementById('buyer-real-fields').classList.remove('hidden');
                document.getElementById('buyer-legal-fields').classList.add('hidden');
            } else {
                document.getElementById('buyer-real-fields').classList.add('hidden');
                document.getElementById('buyer-legal-fields').classList.remove('hidden');
            }
            updatePreview();
        }

        function renderInputItems() {
            const container = document.getElementById('items-container');
            const countBadge = document.getElementById('items-count-badge');
            
            countBadge.textContent = `${items.length} / ${MAX_ITEMS}`;
            
            const btn = document.getElementById('add-item-btn');
            if(items.length >= MAX_ITEMS) {
                btn.classList.add('opacity-40', 'cursor-not-allowed', 'pointer-events-none');
            } else {
                btn.classList.remove('opacity-40', 'cursor-not-allowed', 'pointer-events-none');
            }

            container.innerHTML = items.map((item, idx) => `
                <div class="bg-white border border-slate-200 rounded p-2.5 relative group shadow-sm hover:shadow-md transition">
                    <button onclick="deleteItem(${item.id})" class="absolute left-2 top-2 text-red-400 hover:text-red-600 transition bg-white rounded-full p-1 z-10" title="حذف این ردیف">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                        </svg>
                    </button>
                    <div class="text-[10px] font-bold text-slate-500 mb-1.5 border-b pb-1">ردیف ${idx + 1}</div>
                    <div class="space-y-1.5 mt-1.5">
                        <input type="text" placeholder="شرح خدمات یا کالا..." class="w-full border rounded p-1.5 text-xs outline-none focus:ring-1 focus:ring-sky-500 bg-slate-50" value="${item.desc}" oninput="editItemValue(${item.id}, 'desc', this.value)">
                        <div class="flex gap-1.5">
                            <div class="relative w-16">
                                <label class="block text-[8px] text-gray-500 mb-0.5 ml-1">تعداد</label>
                                <input type="number" class="w-full border rounded p-1 text-xs text-center outline-none focus:ring-1 focus:ring-sky-500 bg-slate-50 font-bold" value="${item.qty}" oninput="editItemValue(${item.id}, 'qty', this.value)" min="1">
                            </div>
                            <div class="relative flex-1">
                                <label class="block text-[8px] text-gray-500 mb-0.5 ml-1">مبلغ واحد (تومان)</label>
                                <input type="text" class="w-full border rounded p-1 text-xs pr-2 pl-10 bg-slate-50 focus:ring-1 focus:ring-sky-500 font-mono text-left font-bold" dir="ltr" value="${item.price > 0 ? formatNumber(item.price) : ''}" oninput="formatAndProcessInput(this); editItemValue(${item.id}, 'price', this.value)">
                                <span class="absolute left-1 top-5 text-[9px] text-gray-400">تومان</span>
                            </div>
                            <div class="relative w-16">
                                <label class="block text-[8px] text-gray-500 mb-0.5 ml-1 text-red-500">تخفیف %</label>
                                <input type="number" class="w-full border rounded p-1 text-xs text-center outline-none focus:ring-1 focus:ring-red-500 bg-red-50 text-red-600 font-bold" value="${item.discountPercent || 0}" oninput="editItemValue(${item.id}, 'discountPercent', this.value)" min="0" max="100">
                                <span class="absolute left-1 top-5 text-[9px] text-red-400">%</span>
                            </div>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        // Localstorage operations for customer saving
        function saveCurrentBuyer() {
            const buyerType = document.querySelector('input[name="buyer_type"]:checked').value;
            const buyer = {
                type: buyerType,
                name: document.getElementById('input-buyer-name').value,
                nid: document.getElementById('input-buyer-nid').value,
                company: document.getElementById('input-buyer-company').value,
                nationalId: document.getElementById('input-buyer-national-id').value,
                regNum: document.getElementById('input-buyer-reg-num').value,
                phone: document.getElementById('input-buyer-phone').value,
                address: document.getElementById('input-buyer-address').value
            };
            
            if (buyerType === 'real' && !buyer.name) {
                showNotification('حداقل نام شخص حقیقی جهت ذخیره‌سازی الزامی است.', 'error');
                return;
            } else if (buyerType === 'legal' && !buyer.company) {
                showNotification('حداقل نام شرکت جهت ذخیره‌سازی الزامی است.', 'error');
                return;
            }

            localStorage.setItem('rayan_tarh_buyer_data', JSON.stringify(buyer));
            showNotification('مشخصات مشتری در مرورگر ذخیره شد.');
        }

        // Archive / Save Complete Invoices
        function saveCurrentInvoiceToArchive() {
            const num = document.getElementById('input-invoice-number').value || 'سند خالی';
            
            const buyerType = document.querySelector('input[name="buyer_type"]:checked').value;
            const name = buyerType === 'real' ? document.getElementById('input-buyer-name').value : document.getElementById('input-buyer-company').value;
            
            const date = document.getElementById('input-invoice-date').value || 'بدون تاریخ';
            
            const fullInvoice = {
                id: Date.now(),
                invoiceNum: num,
                buyerType: buyerType,
                buyerName: document.getElementById('input-buyer-name').value,
                buyerNid: document.getElementById('input-buyer-nid').value,
                buyerCompany: document.getElementById('input-buyer-company').value,
                buyerNationalId: document.getElementById('input-buyer-national-id').value,
                buyerRegNum: document.getElementById('input-buyer-reg-num').value,
                buyerDisplayName: name || 'خریدار ناشناس',
                invoiceDate: date,
                isProforma: document.getElementById('input-is-proforma').checked,
                buyerPhone: document.getElementById('input-buyer-phone').value,
                buyerAddress: document.getElementById('input-buyer-address').value,
                items: items,
                discount: document.getElementById('input-discount').value,
                isTax: document.getElementById('tax-toggle').checked,
                taxPercent: document.getElementById('tax-percent').value,
                bankName: document.getElementById('bank-name').value,
                bankOwner: document.getElementById('bank-owner').value,
                bankCard: document.getElementById('bank-card').value,
                bankShaba: document.getElementById('bank-shaba').value,
                terms: document.getElementById('input-terms').value,
                qrContent: document.getElementById('qr-content').value
            };

            let history = JSON.parse(localStorage.getItem('rayan_invoices_history') || '[]');
            history.unshift(fullInvoice); // Add to beginning
            localStorage.setItem('rayan_invoices_history', JSON.stringify(history));
            
            loadArchiveHistoryList();
            showNotification('فاکتور با موفقیت در سیستم تاریخچه ثبت و آرشیو شد.');
        }

        function loadArchiveHistoryList() {
            const history = JSON.parse(localStorage.getItem('rayan_invoices_history') || '[]');
            const container = document.getElementById('archive-list');
            
            if (history.length === 0) {
                container.innerHTML = `<div class="text-[10px] text-gray-400 text-center py-4 bg-slate-50 border rounded border-dashed">هیچ فاکتور آرشیو شده‌ای یافت نشد.</div>`;
                return;
            }

            container.innerHTML = history.map(inv => `
                <div class="bg-white border rounded p-2 text-xs flex justify-between items-center hover:bg-slate-50 transition shadow-sm">
                    <div class="space-y-0.5">
                        <div class="font-bold text-slate-800">${inv.buyerDisplayName || inv.buyerName || 'خریدار ناشناس'}</div>
                        <div class="text-[9px] text-gray-500">شماره: ${inv.invoiceNum} | تاریخ: ${inv.invoiceDate}</div>
                    </div>
                    <div class="flex gap-1">
                        <button onclick="loadInvoiceFromArchive(${inv.id})" class="text-[9px] bg-slate-100 hover:bg-sky-100 hover:text-sky-700 p-1 px-1.5 rounded text-slate-600 transition">بارگذاری</button>
                        <button onclick="deleteInvoiceFromArchive(${inv.id})" class="text-[9px] bg-red-50 hover:bg-red-100 text-red-600 p-1 px-1.5 rounded transition">حذف</button>
                    </div>
                </div>
            `).join('');
        }

        function loadInvoiceFromArchive(id) {
            const history = JSON.parse(localStorage.getItem('rayan_invoices_history') || '[]');
            const inv = history.find(item => item.id === id);
            
            if (inv) {
                document.getElementById('input-invoice-number').value = inv.invoiceNum || '';
                document.getElementById('input-invoice-date').value = inv.invoiceDate || '';
                document.getElementById('input-is-proforma').checked = inv.isProforma || false;
                
                const type = inv.buyerType || 'real';
                const radioBtn = document.querySelector(`input[name="buyer_type"][value="${type}"]`);
                if(radioBtn) radioBtn.checked = true;
                toggleBuyerType();

                document.getElementById('input-buyer-name').value = inv.buyerName || '';
                document.getElementById('input-buyer-nid').value = inv.buyerNid || '';
                
                document.getElementById('input-buyer-company').value = inv.buyerCompany || (inv.buyerType ? '' : inv.buyerName) || '';
                document.getElementById('input-buyer-national-id').value = inv.buyerNationalId || '';
                document.getElementById('input-buyer-reg-num').value = inv.buyerRegNum || '';
                
                document.getElementById('input-buyer-phone').value = inv.buyerPhone || '';
                document.getElementById('input-buyer-address').value = inv.buyerAddress || '';
                
                items = inv.items || [];
                document.getElementById('input-discount').value = inv.discount || '0';
                document.getElementById('tax-toggle').checked = inv.isTax || false;
                document.getElementById('tax-percent').value = inv.taxPercent || '10';
                document.getElementById('bank-name').value = inv.bankName || '';
                document.getElementById('bank-owner').value = inv.bankOwner || '';
                document.getElementById('bank-card').value = inv.bankCard || '';
                document.getElementById('bank-shaba').value = inv.bankShaba || '';
                document.getElementById('input-terms').value = inv.terms || '';
                document.getElementById('qr-content').value = inv.qrContent || '';

                renderInputItems();
                updatePreview();
                showNotification('فاکتور با موفقیت بازیابی و بارگذاری شد.');
            }
        }

        function deleteInvoiceFromArchive(id) {
            let history = JSON.parse(localStorage.getItem('rayan_invoices_history') || '[]');
            history = history.filter(item => item.id !== id);
            localStorage.setItem('rayan_invoices_history', JSON.stringify(history));
            loadArchiveHistoryList();
            showNotification('سند انتخاب شده از آرشیو حذف گردید.', 'error');
        }

        function clearArchiveHistory() {
            if(confirm("آیا از حذف کل تاریخچه فاکتورها اطمینان دارید؟")) {
                localStorage.removeItem('rayan_invoices_history');
                loadArchiveHistoryList();
                showNotification('آرشیو با موفقیت پاکسازی شد.', 'error');
            }
        }

        // Sync and Live Math Calculations
        function updatePreview() {
            // Title Header Logic
            const isPro = document.getElementById('input-is-proforma').checked;
            const docTitle = document.getElementById('preview-document-title');
            if (isPro) {
                docTitle.textContent = 'پـیـش‌فـاکـتـور ارائه خـدمـات';
                docTitle.className = "text-xs font-black text-amber-700 bg-amber-50 inline-block px-3 py-1 rounded-full border border-amber-200";
            } else {
                docTitle.textContent = 'صورتحساب رسمی فروش کالا و خدمات';
                docTitle.className = "text-xs font-black text-gray-700 bg-slate-100 inline-block px-3 py-1 rounded-full border border-gray-200";
            }

            // Bind values
            document.getElementById('preview-invoice-number').textContent = document.getElementById('input-invoice-number').value || '-';
            document.getElementById('preview-invoice-date').textContent = document.getElementById('input-invoice-date').value || '-';
            
            // Render Buyer Info dynamically based on type
            const buyerType = document.querySelector('input[name="buyer_type"]:checked').value;
            const previewBuyerContainer = document.getElementById('preview-buyer-container');
            const buyerPhone = document.getElementById('input-buyer-phone').value || '-';
            const buyerAddress = document.getElementById('input-buyer-address').value || '-';
            let finalBuyerName = '-';

            if (buyerType === 'real') {
                const name = document.getElementById('input-buyer-name').value || '-';
                const nid = document.getElementById('input-buyer-nid').value || '-';
                finalBuyerName = name;
                
                previewBuyerContainer.innerHTML = `
                    <p class="col-span-2"><strong>نام شخص حقیقی:</strong> <span class="font-bold">${name}</span></p>
                    <p class="col-span-2"><strong>کد ملی:</strong> <span>${nid}</span></p>
                    <p class="col-span-4 mt-0.5"><strong>شماره تماس:</strong> <span>${buyerPhone}</span></p>
                    <p class="col-span-4 mt-0.5"><strong>نشانی محل سکونت:</strong> <span>${buyerAddress}</span></p>
                `;
            } else {
                const company = document.getElementById('input-buyer-company').value || '-';
                const nationalId = document.getElementById('input-buyer-national-id').value || '-';
                const regNum = document.getElementById('input-buyer-reg-num').value || '-';
                finalBuyerName = company;

                previewBuyerContainer.innerHTML = `
                    <p class="col-span-2"><strong>نام شخص حقوقی (شرکت):</strong> <span class="font-bold">${company}</span></p>
                    <p class="col-span-1"><strong>شناسه ملی:</strong> <span>${nationalId}</span></p>
                    <p class="col-span-1"><strong>شماره ثبت:</strong> <span>${regNum}</span></p>
                    <p class="col-span-4 mt-0.5"><strong>شماره تماس:</strong> <span>${buyerPhone}</span></p>
                    <p class="col-span-4 mt-0.5"><strong>نشانی فعالیت:</strong> <span>${buyerAddress}</span></p>
                `;
            }
            
            document.getElementById('preview-signature-buyer').textContent = finalBuyerName !== '-' ? finalBuyerName : 'نام خریدار';

            // Terms
            document.getElementById('preview-terms').textContent = document.getElementById('input-terms').value;

            // Bank Details block render toggle
            const showBank = document.getElementById('show-bank-toggle').checked;
            const bankBlock = document.getElementById('preview-bank-block');
            if(showBank) {
                bankBlock.style.display = 'block';
                document.getElementById('preview-bank-name').textContent = document.getElementById('bank-name').value;
                document.getElementById('preview-bank-owner').textContent = document.getElementById('bank-owner').value;
                document.getElementById('preview-bank-card').textContent = document.getElementById('bank-card').value;
                document.getElementById('preview-bank-shaba').textContent = document.getElementById('bank-shaba').value;
            } else {
                bankBlock.style.display = 'none';
            }

            // QR Code rendering via Server API
            const qrVal = document.getElementById('qr-content').value || 'https://rayantarh.com';
            document.getElementById('preview-qr-img').src = `https://api.qrserver.com/v1/create-qr-code/?size=100x100&data=${encodeURIComponent(qrVal)}`;

            // Render Items in PDF
            const tbody = document.getElementById('preview-items-body');
            let subtotal = 0;

            if (items.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="text-gray-400 py-6 text-xs text-center">هیچ ردیفی جهت نمایش ثبت نشده است</td></tr>`;
                for (let i = 0; i < 4; i++) {
                    tbody.innerHTML += `<tr class="h-8"><td></td><td></td><td></td><td></td><td></td><td></td></tr>`;
                }
            } else {
                tbody.innerHTML = items.map((item, index) => {
                    const price = item.price || 0;
                    const qty = item.qty || 0;
                    const discountP = item.discountPercent || 0;
                    
                    const rowBaseTotal = qty * price;
                    const rowDiscountVal = (rowBaseTotal * discountP) / 100;
                    const rowNetTotal = Math.round(rowBaseTotal - rowDiscountVal);
                    
                    subtotal += rowNetTotal;
                    
                    // Add visual badge for discount on the paper if exists
                    const discountBadge = discountP > 0 ? `<span class="bg-red-50 text-red-600 border border-red-200 px-1 py-0.5 rounded text-[9px] font-bold">${discountP}%</span>` : `<span class="text-gray-300">-</span>`;

                    return `
                        <tr class="hover:bg-slate-50 transition h-8 border-b border-slate-100">
                            <td class="font-bold text-gray-500">${index + 1}</td>
                            <td class="text-right px-2.5 text-gray-800 font-medium">${item.desc || '-'}</td>
                            <td class="font-bold text-gray-700">${qty}</td>
                            <td class="font-mono text-gray-700">${formatNumber(price)}</td>
                            <td class="text-center">${discountBadge}</td>
                            <td class="font-mono font-bold text-gray-900 bg-slate-50/50">${formatNumber(rowNetTotal)}</td>
                        </tr>
                    `;
                }).join('');
            }

            // Math final
            let overallDiscountPercent = parseFloat(document.getElementById('input-discount').value) || 0;
            if (overallDiscountPercent < 0) overallDiscountPercent = 0;
            if (overallDiscountPercent > 100) overallDiscountPercent = 100;
            
            let overallDiscountVal = Math.round((subtotal * overallDiscountPercent) / 100);
            let subtotalAfterDiscount = subtotal - overallDiscountVal;
            if (subtotalAfterDiscount < 0) subtotalAfterDiscount = 0;

            // TAX calculations
            const taxToggle = document.getElementById('tax-toggle').checked;
            const taxRate = parseFloat(document.getElementById('tax-percent').value) || 0;
            let taxAmount = 0;

            if (taxToggle && taxRate > 0) {
                taxAmount = Math.round((subtotalAfterDiscount * taxRate) / 100);
                document.getElementById('preview-tax-row').style.display = 'flex';
                document.getElementById('preview-tax-rate').textContent = taxRate;
                document.getElementById('preview-tax-amount').textContent = formatNumber(taxAmount);
            } else {
                document.getElementById('preview-tax-row').style.display = 'none';
            }

            // Net final total
            const netTotal = subtotalAfterDiscount + taxAmount;

            document.getElementById('preview-subtotal').textContent = formatNumber(subtotal);
            
            // Show/Hide Discount rows
            if (overallDiscountVal > 0) {
                document.getElementById('preview-discount-row').style.display = 'flex';
                document.getElementById('preview-discount-amount').innerHTML = `${formatNumber(overallDiscountVal)} <span class="text-[9px] bg-red-100 text-red-700 px-1 rounded mr-1">تخفیف کل (${overallDiscountPercent}%)</span>`;
            } else {
                document.getElementById('preview-discount-row').style.display = 'none';
            }

            document.getElementById('preview-net-total').textContent = formatNumber(netTotal);
            
            // Farsi words translations
            const words = numToPersianWords(netTotal);
            document.getElementById('preview-total-words').textContent = netTotal > 0 ? `${words} تومان` : 'صفر تومان';
            
            // Show Rial conversion under the words
            const rials = netTotal * 10;
            document.getElementById('preview-currency-ria').textContent = netTotal > 0 ? `معادل ریالی: ${formatNumber(rials)} ریال` : '';
        }

        // Export high resolution single page A4 PDF
        function generatePDF() {
            const element = document.getElementById('invoice-paper');
            const invNum = document.getElementById('input-invoice-number').value || 'New';
            const isPro = document.getElementById('input-is-proforma').checked;
            const prefix = isPro ? 'Proforma' : 'Invoice';
            
            // Handle viewport scale on mobile during rendering
            const originalTransform = element.style.transform;
            element.style.transform = 'scale(1)'; 
            element.style.marginBottom = '0';

            const opt = {
                margin:       0,
                filename:     `${prefix}-RayanTarh-${invNum.replace(/\//g, '_')}.pdf`,
                image:        { type: 'jpeg', quality: 1.0 },
                html2canvas:  { 
                    scale: 2.2, // Extremely clean high density vector representation
                    useCORS: true, 
                    logging: false,
                    scrollY: 0,
                    letterRendering: true
                },
                jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' }
            };

            // Loading UI feedback
            const btn = document.querySelector('header button');
            const originalHtml = btn.innerHTML;
            btn.innerHTML = 'در حال ساخت فایل PDF...';
            btn.classList.add('opacity-75', 'cursor-wait');
            btn.disabled = true;

            html2pdf().set(opt).from(element).save().then(() => {
                // Restore mobile layouts
                element.style.transform = originalTransform;
                if(window.innerWidth <= 1024) element.style.marginBottom = '-75mm';
                if(window.innerWidth <= 768) element.style.marginBottom = '-140mm';
                
                btn.innerHTML = originalHtml;
                btn.classList.remove('opacity-75', 'cursor-wait');
                btn.disabled = false;
                
                showNotification('فایل فاکتور PDF شما با موفقیت تولید و دانلود شد.');
            }).catch(err => {
                console.error("PDF generation failed:", err);
                btn.innerHTML = originalHtml;
                btn.classList.remove('opacity-75', 'cursor-wait');
                btn.disabled = false;
                showNotification('خطا در تولید PDF فاکتور.', 'error');
            });
        }
    </script>
